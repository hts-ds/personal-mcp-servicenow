# ServiceNow Basic Auth configuration (do not commit a real .env file).
#
# Option A: canonical variable names
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-service-account
SERVICENOW_PASSWORD=replace-with-a-secret-manager-or-local-secret

# Option B: reference an already protected local H104 credential file.
# Values in the operating-system environment take priority over this file.
# SERVICENOW_ENV_FILE=D:\DEV\HTS\ServiceNow\.env

# Local MCP client transport.
MCP_TRANSPORT=stdio
